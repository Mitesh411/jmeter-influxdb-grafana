          "resultFormat": "time_series",
          "query": "SELECT sum(\"count\") FROM \"jmeter\" WHERE \"application\" =~ /^$application$/ AND \"runId\" =~ /^$run$/ AND \"transaction\" = 'all' AND \"statut\" = 'all' AND $timeFilter"
