{
  "title": "Backend load test (JMeter)",
  "uid": "jmeter-influxdb",
  "description": "Live JMeter metrics from InfluxdbBackendListenerClient (InfluxDB 1.x, measurement 'jmeter'), failed requests from 'failures'.",
  "tags": [
    "performance",
    "jmeter",
    "influxdb",
    "load-test"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "Performance dashboards",
      "type": "dashboards",
      "tags": [
        "performance"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Jenkins",
      "type": "link",
      "url": "http://localhost:8080/job/performance-test/",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Start a test run"
    },
    {
      "title": "HTML reports",
      "type": "link",
      "url": "http://localhost:8081/",
      "targetBlank": true,
      "icon": "doc",
      "tooltip": "JMeter and sitespeed.io reports"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Test start / end",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "enable": true,
        "iconColor": "#8F3BB8",
        "query": "SELECT \"text\" FROM \"events\" WHERE \"application\" =~ /^$application$/ AND \"runId\" =~ /^$run$/ AND $timeFilter",
        "textColumn": "text",
        "tagsColumn": "title"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "label": "Data source",
        "type": "datasource",
        "query": "influxdb",
        "refresh": 1,
        "hide": 0,
        "current": {}
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "query": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"application\"",
        "definition": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"application\"",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "query": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"runId\" WHERE \"application\" =~ /^$application$/ AND $timeFilter",
        "definition": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"runId\" WHERE \"application\" =~ /^$application$/ AND $timeFilter",
        "regex": "",
        "refresh": 2,
        "sort": 2,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "transaction",
        "label": "Transaction",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "query": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"transaction\" WHERE \"application\" =~ /^$application$/",
        "definition": "SHOW TAG VALUES FROM \"jmeter\" WITH KEY = \"transaction\" WHERE \"application\" =~ /^$application$/",
        "regex": "/^(?!all$|internal$).*/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
