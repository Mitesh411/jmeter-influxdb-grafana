          "resultFormat": "time_series",
          "query": "SELECT \"largestContentfulPaint\" FROM \"sitespeed\" WHERE \"application\" =~ /^$application$/ AND \"runId\" =~ /^$run$/ AND \"page\" =~ /^$page$/ AND $timeFilter GROUP BY \"page\"",
          "alias": "$tag_page"
        }
      ],
