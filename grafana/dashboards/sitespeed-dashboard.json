        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 0,
            "spanNulls": true,
            "drawStyle": "line",
            "showPoints": "always"
          },
          "decimals": 0
