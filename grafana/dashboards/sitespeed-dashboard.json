{
  "title": "Frontend performance (sitespeed.io)",
  "uid": "sitespeed-influxdb",
  "description": "Core Web Vitals, visual metrics and page weight per page from sitespeed.io (measurement 'sitespeed', written per iteration by sitespeed/plugins/influxdb).",
  "tags": [
    "performance",
    "sitespeed"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "Performance dashboards",
      "type": "dashboards",
      "tags": [
        "performance"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "Jenkins",
      "type": "link",
      "url": "http://localhost:8080/job/performance-test/",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "Start a test run"
    },
    {
      "title": "HTML reports",
      "type": "link",
      "url": "http://localhost:8081/",
      "targetBlank": true,
      "icon": "doc",
      "tooltip": "JMeter and sitespeed.io reports"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Frontend runs",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "enable": true,
        "iconColor": "#1F60C4",
        "query": "SELECT \"title\" FROM \"test_runs\" WHERE \"tool\" = 'sitespeed' AND \"application\" =~ /^$application$/ AND \"runId\" =~ /^$run$/ AND $timeFilter",
        "textColumn": "title"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "label": "Data source",
        "type": "datasource",
        "query": "influxdb",
        "refresh": 1,
        "hide": 0,
        "current": {}
      },
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "query": "SHOW TAG VALUES FROM \"sitespeed\" WITH KEY = \"application\"",
        "definition": "SHOW TAG VALUES FROM \"sitespeed\" WITH KEY = \"application\"",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "query": "SHOW TAG VALUES FROM \"sitespeed\" WITH KEY = \"runId\" WHERE \"application\" =~ /^$application$/ AND $timeFilter",
        "definition": "SHOW TAG VALUES FROM \"sitespeed\" WITH KEY = \"runId\" WHERE \"application\" =~ /^$application$/ AND $timeFilter",
        "regex": "",
        "refresh": 2,
        "sort": 2,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "page",
        "label": "Page",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${DS}"
        },
        "query": "SHOW TAG VALUES FROM \"sitespeed\" WITH KEY = \"page\" WHERE \"application\" =~ /^$application$/",
        "definition": "SHOW TAG VALUES FROM \"sitespeed\" WITH KEY = \"page\" WHERE \"application\" =~ /^$application$/",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "reports_url",
        "type": "constant",
        "query": "http://localhost:8081",
        "hide": 2,
        "current": {
          "text": "http://localhost:8081",
          "value": "http://localhost:8081"
        },
        "options": [
          {
            "selected": true,
            "text": "http://localhost:8081",
            "value": "http://localhost:8081"
          }
        ]
      }
    ]
  },
