# Local demo defaults. Change before exposing anything beyond localhost.
INFLUXDB_DB=jmeter
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# JMeter run settings (override per run, e.g. THREADS=20 docker compose run --rm jmeter)
TEST_PLAN=blazedemo.jmx
THREADS=5
RAMPUP=10
DURATION=120
APPLICATION=blazedemo
TEST_TITLE=BlazeDemo smoke load test
