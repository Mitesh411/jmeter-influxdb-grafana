# Local demo defaults. Change before exposing anything beyond localhost.
INFLUXDB_DB=jmeter
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin
# Group id that owns /var/run/docker.sock. 0 on Docker Desktop; on Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=0

# --- Test run settings (override per run, e.g. THREADS=20 docker compose run --rm jmeter) ---
# RUN_ID tags every metric of a run (default: UTC timestamp). Use the same RUN_ID for a
# JMeter and a sitespeed.io run to see them as one run in Grafana.
# RUN_ID=
# APPLICATION / TEST_TITLE default to the plan or URL file name.
# APPLICATION=
# TEST_TITLE=

# Backend load test (JMeter): plan file in jmeter/test-plans
TEST_PLAN=blazedemo.jmx
THREADS=5
RAMPUP=10
DURATION=120
# Optional: override the plan's target (empty = plan default)
TARGET_HOST=
TARGET_PORT=
TARGET_PROTOCOL=
# Exit with code 2 (Jenkins: UNSTABLE) when the error % is above this. Empty = no check.
MAX_ERROR_PCT=

# Frontend test (sitespeed.io): URL file in sitespeed/urls, or space-separated URLs
SITESPEED_URLS=blazedemo.txt
SITESPEED_ITERATIONS=3
SITESPEED_BROWSER=chrome
SITESPEED_CONNECTIVITY=native
